# Get your Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Database URL
# For local development: file:./journal.db
# For Turso (production): libsql://your-db.turso.io
DATABASE_URL=file:./journal.db

# Turso auth token (only needed for Turso/Vercel deployment)
# Get from: turso db tokens create your-db-name
DATABASE_AUTH_TOKEN=
